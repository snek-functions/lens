LENS_NAME=app
LENS_NETWORKS=192.168.1.0/24
LENS_PORTS=80,443,8080

# Port the server listens on (Bun default 3000 when unset).
PORT=3000

# Built-in OIDC (Zitadel) auth — NOT basic auth. Required for the guarded
# mutations (updateInternalPassword, serviceUpdate). Without it those resolvers
# reject every call. Set to your Zitadel issuer URL.
AUTH_ISSUER=
# JSON key of an API application in that Zitadel (Private Key JWT); Pylon
# introspects bearer tokens with it. Required together with AUTH_ISSUER.
AUTH_KEY=
# Id of the Zitadel project that defines lens:admin. Required, the server
# refuses to start without it. Roles count only from the claim
# urn:zitadel:iam:org:project:<AUTH_PROJECT_ID>:roles, never from the roles
# claim of another project. For photonq.org this is PHOTONQ 268418173034829430.
AUTH_PROJECT_ID=

# TLS (optional). When both files exist the server serves HTTPS in-process.
# LENS_TLS_KEY=/private/tls.key
# LENS_TLS_CERT=/private/tls.crt
# PASSPHRASE=
